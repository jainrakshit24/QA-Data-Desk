# QA Data Desk — copy this file to .env and fill in what you need.
#   cp .env.example .env
# .env is git-ignored. Real environment variables always win over this file, so a container's
# settings are never overwritten. Nothing here is required: you can add databases in the app instead.

# ---------------------------------------------------------------- database (optional)
# One connection can come from the environment — handy for Docker or a shared server.
# Add any number of others in the app: Settings → Databases.
# Use a database user with SELECT permission only. The app is read-only either way.
QA_DB_HOST=db.example.com
QA_DB_PORT=3306
QA_DB_USER=readonly_user
QA_DB_PASSWORD=change-me
QA_DB_NAME=your_database
QA_DB_LABEL=Staging                  # how it is shown in the sidebar

# ---------------------------------------------------------------- accounts
# One-time code needed to create the first admin account. Printed by ./run.sh when not set.
QA_SETUP_CODE=choose-a-long-random-code
# Where accounts, saved queries, check history and snapshots live (SQLite).
# QA_APP_DB=/data/app_data.sqlite3

# ---------------------------------------------------------------- AI (optional)
# Gemini gets table names, column names, your question and SQL text — never rows.
# Create a free key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest

# ---------------------------------------------------------------- your own checks and notes (optional)
# Folder with your team's checks, charts, links and AI notes (default: ./local, git-ignored).
# QA_LOCAL_DIR=/path/to/your/qa-pack

# ---------------------------------------------------------------- scheduled checks (optional)
# Used by `python3 scheduler.py --notify webhook`. Slack-compatible JSON; counts only, never rows.
# QA_ALERT_WEBHOOK=https://hooks.slack.com/services/...
